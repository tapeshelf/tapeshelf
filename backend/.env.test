# Used by `npm run test:e2e` (loaded by vitest.config.e2e.ts). Points at the throwaway test database/buckets.
NODE_ENV=test
PORT=0
LOG_LEVEL=silent
PUBLIC_URL=http://localhost:4200
SITE_NAME=tapeshelf
CONTACT_EMAIL=contact@example.test
LEGAL_DIR=test/legal
RATE_LIMITS=false
# Most suites exercise Free/Pro, which only the cloud has; community.e2e-spec.ts switches to self-hosted.
EDITION=cloud
# Paddle for the cloud suites: a fake sandbox account; the API is a local stub (test/utils/paddle-stub.ts)
# and webhooks are signed by the tests with this secret.
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_test
PADDLE_CLIENT_TOKEN=test_clienttoken
PADDLE_WEBHOOK_SECRET=pdl_ntfset_test_secret
PADDLE_PRICE_MONTH=pri_month
PADDLE_PRICE_YEAR=pri_year
PADDLE_API_URL=http://127.0.0.1:3399
DATABASE_URL=postgresql://tapeshelf:tapeshelf@localhost:5433/tapeshelf_test
REDIS_URL=redis://localhost:6379/1
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PRIVATE=tapeshelf-test-private
S3_BUCKET_PUBLIC=tapeshelf-test-public
S3_FORCE_PATH_STYLE=true
OPS_TOKEN=test-ops-token-0123456789
COOKIE_SECRET=test-cookie-secret-0123456789abcdef0123456789
JWT_SECRET=test-jwt-secret-0123456789abcdef0123456789abcd
KEK=1111111111111111111111111111111111111111111111111111111111111111
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="TapeShelf Test <test@example.com>"
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
WORKER_TMP_DIR=/tmp/tapeshelf-test
WORKER_CONCURRENCY=1
WORKER_HEALTH_PORT=0

# Google sign-in stays off in tests even when backend/.env has a client (ConfigModule also reads .env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
